rules_version = '2';

// =========================================================
//  REGRAS DE SEGURANÇA — SSA Guias
//
//  Este arquivo é o que de fato protege os dados. Esconder um
//  menu ou bloquear uma rota no React não impede ninguém de
//  chamar o Firestore direto — estas regras impedem.
//
//  Níveis (campo `role` em users/{uid}):
//    operacional → telas do operacional. Dentro dele:
//      · gerência (users/{uid}.gerencia == true) → tudo, e é quem decide
//        o que cada conta pode ver (tela Controle de acessos);
//      · as demais contas seguem users/{uid}.acessos: { tela: false }
//        bloqueia a tela. Os dados EXCLUSIVOS de uma tela (custos, Central
//        de Informações, usuários, turnos, acessos) ficam bloqueados aqui
//        também; dados usados por várias telas (serviços, guias, escala…)
//        continuam liberados para todo o Operacional.
//    comercial   → só a Central de Dúvidas (faq_itens)
//    guia        → própria disponibilidade (dentro da janela configurável), próprios idiomas e própria foto
//    fornecedor  → parceiro plotado (users/{uid}.fornecedorId): lê o próprio
//                  cadastro (veículos), cuida dos próprios motoristas e da
//                  escala de motoristas do dia ({AAAA-MM-DD}__{fornecedorId}).
//                  Não lê nada do Operacional.
//  Conta sem documento em `users`, ou com ativo != true → nada.
//
//  BALANÇO DE USO — atividade_diaria/{uid}__{dia} e avaliacoes/{uid}:
//    cada conta grava só o próprio registro de uso e a própria avaliação;
//    quem lê tudo é a gerência e as contas com users/{uid}.verBalanco == true
//    (marcadas pela gerência).
//
//  REGIÕES (bases Luck) — users/{uid}.regiao (sem o campo = 'ssa'):
//    Salvador ('ssa') é a sede e tem tudo acima. Conta do Operacional de
//    OUTRA base só lê/grava o que é da base dela: os documentos de
//    configuração com o sufixo da base (settings/turnos_equipe__nat…), o
//    monitoramento de OUT marcado com a região dela e a lista de regiões.
//    Cadastros, escala, custos etc. (dados de Salvador) ficam fechados.
//    A gerência é da sede: vê tudo e cadastra as bases (settings/regioes).
//    CADASTROS POR BASE: as telas liberadas para a base usam as coleções
//    com o sufixo dela (guides__nat, services__nat…) — cada base tem os
//    próprios guias, passeios, disponibilidade e escala; a conta da base lê
//    e grava só as coleções com o sufixo da própria base.
// =========================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function perfilPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function ativo() {
      return signedIn()
        && exists(perfilPath())
        && get(perfilPath()).data.ativo == true;
    }

    function roleIs(nivel) {
      return ativo() && get(perfilPath()).data.role == nivel;
    }

    function isOperacional() { return roleIs('operacional'); }

    // ---------- Controle de acessos por tela (operacional) ----------
    // Mesmas chaves de src/Context/acessos.js.
    function meuPerfil() { return get(perfilPath()).data; }
    function isGerencia() {
      return isOperacional() && meuPerfil().get('gerencia', false) == true;
    }
    function podeArea(area) {
      return isOperacional()
        && (meuPerfil().get('gerencia', false) == true
            || meuPerfil().get('acessos', {}).get(area, true) != false);
    }
    // ---------- Regiões (bases Luck) ----------
    function minhaRegiao() { return meuPerfil().get('regiao', 'ssa'); }
    // Salvador (sede) ou gerência: segue as regras de sempre
    function daSede() {
      return isOperacional()
        && (meuPerfil().get('gerencia', false) == true || minhaRegiao() == 'ssa');
    }
    // documento de configuração da base: <nome>__<regiao>
    function docDaMinhaBase(id) {
      return id.matches('.+__' + minhaRegiao());
    }
    // cadastros próprios de cada base: a mesma coleção de Salvador com o
    // sufixo da base (guides__nat, services__nat, weekly_services__nat…)
    function colecaoDaMinhaBase(col) {
      return col.matches('.+__' + minhaRegiao());
    }
    // o que uma conta de OUTRA base pode ler / gravar
    function regionalLe(col, id) {
      return isOperacional() && !daSede() && (
        colecaoDaMinhaBase(col)
        || (col == 'settings' && (docDaMinhaBase(id) || id == 'regioes'))
        || (col == 'painel_out_monitoramento' && resource.data.regiao == minhaRegiao())
      );
    }
    function regionalGrava(col, id) {
      return isOperacional() && !daSede() && (
        colecaoDaMinhaBase(col)
        || (col == 'settings' && docDaMinhaBase(id)
          && (!id.matches('turnos_equipe__.*') || podeArea('demandaTurnos')))
        || (col == 'painel_out_monitoramento' && docDaMinhaBase(id)
          && request.resource.data.regiao == minhaRegiao())
      );
    }

    // ---------- Atendimento no aeroporto (cartinhas) ----------
    // Conta "atendimento": só o painel do aeroporto da própria base. Lê e grava
    // as marcas (Recepcionei / Embarquei) em atendimentos[__base].
    function isAtendimento() { return roleIs('atendimento'); }
    function colecaoAtendimentos(col) {
      return (minhaRegiao() == 'ssa' && col == 'atendimentos')
        || col == 'atendimentos__' + minhaRegiao();
    }
    function atendimentoValido() {
      return request.resource.data.keys().hasOnly([
          'data', 'chave', 'veiculo', 'motorista', 'voos', 'hora', 'pax',
          'reservas', 'marcas', 'noShow', 'recepcoes', 'atualizadoEm'])
        && request.resource.data.data is string
        && request.resource.data.marcas is map;
    }

    // ---------- Fornecedor parceiro (plotado) ----------
    function isFornecedor() { return roleIs('fornecedor'); }
    function meuFornecedor() { return meuPerfil().get('fornecedorId', '--'); }
    // a coleção da base do fornecedor: providers (Salvador) ou providers__nat
    function colDaMinhaBase(col, nome) {
      return (minhaRegiao() == 'ssa' && col == nome) || col == nome + '__' + minhaRegiao();
    }
    function motoristaValido() {
      return request.resource.data.keys().hasOnly(['fornecedorId', 'nome', 'telefone', 'ativo', 'tokenApp', 'criadoEm', 'atualizadoEm'])
        && request.resource.data.fornecedorId == meuFornecedor()
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 80;
    }
    function escalaMotoristasValida(docId) {
      return docId.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}__' + meuFornecedor())
        && request.resource.data.keys().hasOnly(['data', 'fornecedorId', 'fornecedorNome', 'servicos', 'links', 'atualizadoEm'])
        && request.resource.data.fornecedorId == meuFornecedor()
        && request.resource.data.servicos is map
        && request.resource.data.servicos.size() <= 300
        && (!('links' in request.resource.data) || request.resource.data.links.size() <= 100);
    }
    // link do dia do motorista (motorista_dia/{token}) montado pelo fornecedor
    function linkMotoristaValido() {
      return request.resource.data.keys().hasOnly([
          'base', 'data', 'fornecedorId', 'fornecedorNome', 'motoristaId', 'motoristaNome',
          'motoristaTelefone', 'minutosAntesCheguei', 'servicos', 'criadoEm', 'atualizadoEm',
          'eventos', 'ultimaPosicao'])
        && request.resource.data.fornecedorId == meuFornecedor()
        && request.resource.data.base == minhaRegiao()
        && request.resource.data.servicos is list
        && request.resource.data.servicos.size() <= 60;
    }

    // Balanço de uso: gerência + contas marcadas pela gerência
    function podeVerBalanco() {
      return ativo() && (isGerencia() || meuPerfil().get('verBalanco', false) == true);
    }


    // Coleções / documentos que pertencem a UMA tela só
    function podeLerColecao(col, id) {
      return regionalLe(col, id) || daSede() && !(col in ['users', 'atividade_diaria', 'avaliacoes']) && (
        (col in ['custos_dia', 'auditoria_dia'] && podeArea('custos'))
        || (col == 'settings' && id == 'custos'
            && (podeArea('custos') || podeArea('servicosFornecedor')))
        || ((col == 'faq_itens' || col == 'arquivos')
            && (podeArea('centralInformacoes') || podeArea('verComercial')))
        || (!(col in ['custos_dia', 'auditoria_dia', 'faq_itens', 'arquivos'])
            && !(col == 'settings' && id == 'custos'))
      );
    }
    function podeGravarColecao(col, id) {
      return regionalGrava(col, id) || daSede() && !(col in ['users', 'atividade_diaria', 'avaliacoes']) && (
        (col in ['custos_dia', 'auditoria_dia'] && podeArea('custos'))
        || (col == 'settings' && id == 'custos' && podeArea('custos'))
        || (col == 'settings' && (id == 'turnos_equipe' || id.matches('turnos_equipe__.*')) && podeArea('demandaTurnos'))
        || (col == 'settings' && id in ['acessos', 'regioes'] && isGerencia())
        || ((col == 'faq_itens' || col == 'arquivos') && podeArea('centralInformacoes'))
        || (!(col in ['custos_dia', 'auditoria_dia', 'faq_itens', 'arquivos'])
            && !(col == 'settings' && (id in ['custos', 'turnos_equipe', 'acessos', 'regioes'] || id.matches('turnos_equipe__.*'))))
      );
    }
    function isComercial()   { return roleIs('comercial'); }

    function isGuiaDono(guideId) {
      return roleIs('guia') && get(perfilPath()).data.guideId == guideId;
    }

    // Dia da semana atual em Salvador (UTC-3), 0 = domingo ... 6 = sábado
    // (mesma convenção do Date.getDay() do JavaScript).
    // 1970-01-01 foi uma quinta-feira: dias desde então, mod 7, dá 0 pra
    // quinta — soma-se 4 e tira-se o resto de novo pra realinhar em domingo=0.
    function diaSemanaAtual() {
      let diaLocal = math.floor((request.time.toMillis() - 10800000) / 86400000.0);
      return ((diaLocal % 7) + 4) % 7;
    }

    // Janela CONFIGURÁVEL em que o guia pode enviar/alterar disponibilidade
    // — dia de abertura (00:00) e de fechamento (23:59:59), guardados em
    // settings/scale (janelaDisponibilidadeAbertura/Fechamento, 0–6).
    // Sem configuração salva: padrão quinta(4) a sexta(5).
    // Mesma regra de src/Services/Utils/janelaDisponibilidade.js — se mudar
    // a fórmula aqui, mude lá também.
    function janelaAberta() {
      let configPath = /databases/$(database)/documents/settings/scale;
      let temConfig = exists(configPath);
      let abertura = temConfig
        ? get(configPath).data.get('janelaDisponibilidadeAbertura', 4)
        : 4;
      let fechamento = temConfig
        ? get(configPath).data.get('janelaDisponibilidadeFechamento', 5)
        : 5;
      let duracao = ((fechamento - abertura + 7) % 7) + 1;
      let diasDesdeAbertura = (diaSemanaAtual() - abertura + 7) % 7;
      return diasDesdeAbertura < duracao;
    }

    // ---------- Perfis de acesso ----------
    match /users/{uid} {
      // cada um lê o próprio perfil (o app precisa dele pra saber o nível,
      // inclusive pra avisar "conta desativada")
      allow read: if signedIn() && request.auth.uid == uid;
      // a própria conta só pode atualizar o contador das boas-vindas
      // (modal das primeiras entradas) — nenhum outro campo
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['boasVindasVistas', 'boasVindasUltima'])
        && request.resource.data.boasVindasVistas is int
        && request.resource.data.boasVindasVistas <= 10;
      // ...o último login / último acesso / última tela (Balanço de uso) e a
      // resposta ao convite de avaliação ("Depois" / "Não mostrar mais")
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['ultimoLogin', 'ultimoAcesso', 'ultimaTela', 'avaliacaoConvite']);
      // ...e, no primeiro acesso, avisar que trocou a senha temporária
      // (só pode DESLIGAR a marcação, nunca ligar)
      allow update: if signedIn() && request.auth.uid == uid
        && resource.data.get('senhaTemporaria', false) == true
        && request.resource.data.senhaTemporaria == false
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['senhaTemporaria', 'senhaDefinidaEm']);
      // quem vê o Balanço de uso enxerga a lista de contas (nome, nível, último acesso)
      allow read: if podeVerBalanco();
      // Demanda por turno (Configurar escala): lista as contas de Atendimento e
      // do Operacional da própria base para montar a equipe (reaproveita a conta)
      allow read: if podeArea('demandaTurnos') && resource.data.role in ['atendimento', 'operacional']
        && (daSede() || resource.data.get('regiao', 'ssa') == minhaRegiao());
      // GERÊNCIA: cria, edita, lista e remove qualquer perfil — inclusive
      // contas do Operacional, a marcação de gerência e os acessos por tela.
      allow read, write: if isGerencia();
      // Operacional com a tela "Usuários" liberada: lista as contas e cuida
      // SÓ das contas do Comercial e dos Guias. Não cria nem altera conta do
      // Operacional/gerência e não mexe em gerência nem em acessos.
      allow read: if podeArea('usuarios') && daSede();
      allow create: if podeArea('usuarios') && daSede()
        && request.resource.data.role in ['comercial', 'guia', 'atendimento', 'fornecedor']
        && request.resource.data.keys().hasOnly([
             'nome', 'email', 'role', 'ativo', 'guideId', 'guideName',
             'colaboradorId', 'colaboradorNome', 'fornecedorId', 'fornecedorNome',
             'createdAt', 'createdBy', 'senhaTemporaria'
           ]);
      allow update: if podeArea('usuarios') && daSede()
        && resource.data.role in ['comercial', 'guia', 'atendimento', 'fornecedor']
        && resource.data.get('gerencia', false) != true
        && request.resource.data.role in ['comercial', 'guia', 'atendimento', 'fornecedor']
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['nome', 'role', 'ativo', 'guideId', 'guideName',
                       'colaboradorId', 'colaboradorNome', 'fornecedorId', 'fornecedorNome', 'updatedAt']);
      allow delete: if podeArea('usuarios') && daSede()
        && resource.data.role in ['comercial', 'guia', 'atendimento', 'fornecedor'];
      // NINGUÉM se promove a gerência: o campo `gerencia` só muda pela
      // própria gerência (regra acima). A primeira gerência é definida pelo
      // administrador direto no console do Firebase.
    }

    // ---------- Guia: só o próprio documento de disponibilidade ----------
    match /guide_availability/{guideId} {
      // lê sempre (mesmo com a janela fechada, pra ver o que enviou)
      allow read: if isGuiaDono(guideId);
      // grava só dentro da janela (quinta 00h → sexta 23h59)
      allow create, update: if isGuiaDono(guideId)
        && janelaAberta()
        && request.resource.data.guideId == guideId
        && request.resource.data.disponibilidade is list;
    }

    // ---------- Todo mundo logado e ativo lê a configuração da escala ----------
    // É preciso pra tela do guia mostrar quando a janela abre/fecha. Só o
    // operacional grava (regra geral, lá embaixo).
    // Exceção: settings/custos (tarifas dos fornecedores e referência de
    // valor dos guias) é só do operacional — cai na regra geral.
    match /settings/{settingId} {
      // conta de outra base: só a lista de regiões e os documentos da base dela
      allow read: if ativo() && settingId != 'custos' && !isFornecedor()
        && (!isOperacional() || daSede() || settingId in ['regioes', 'acessos'] || docDaMinhaBase(settingId));
      // fornecedor parceiro: só a lista de bases e o vínculo veículo → fornecedor
      allow read: if isFornecedor()
        && (settingId == 'regioes'
            || (minhaRegiao() == 'ssa' && settingId in ['vinculos_veiculos_fornecedor', 'painel_fornecedor'])
            || settingId == 'vinculos_veiculos_fornecedor__' + minhaRegiao()
            || settingId == 'painel_fornecedor__' + minhaRegiao());
      // settings/acessos: só a gerência grava (regra geral, lá embaixo)
    }

    // ---------- Guia: lê (sem alterar) o próprio perfil e o catálogo ----------
    match /guides/{guideId} {
      allow get: if isGuiaDono(guideId);
      // O guia só altera os PRÓPRIOS IDIOMAS — nenhum outro campo do cadastro.
      allow update: if isGuiaDono(guideId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['idiomas', 'updatedAt'])
        && request.resource.data.idiomas is list
        && request.resource.data.idiomas.size() <= 20;
    }
    // ---------- Guia: própria foto de perfil ----------
    // guide_fotos/{guideId}: { guideId, foto (data URL JPEG), atualizadoEm }.
    // O guia lê, troca e remove só a própria foto; o operacional lê todas
    // (aparecem junto do nome do guia nas telas) pela regra geral; o
    // comercial lê uma a uma (foto do motoguia na Central, pelo id do guia).
    match /guide_fotos/{guideId} {
      allow get: if isGuiaDono(guideId) || isComercial();
      allow delete: if isGuiaDono(guideId);
      allow create, update: if isGuiaDono(guideId)
        && request.resource.data.keys().hasOnly(['guideId', 'foto', 'atualizadoEm'])
        && request.resource.data.guideId == guideId
        && request.resource.data.foto is string
        && request.resource.data.foto.matches('^data:image/jpeg;base64,.*')
        && request.resource.data.foto.size() < 200000;
    }
    match /guide_tour_levels/{guideId} {
      allow get: if isGuiaDono(guideId);
    }
    match /services/{serviceId} {
      allow read: if roleIs('guia');
    }

    // ---------- Notificações em tempo real pro operacional ----------
    // O guia só CRIA (uma por envio/alteração), sempre em nome do próprio
    // guia. Não lê, não edita, não apaga. O operacional lê e marca como lida
    // pela regra geral lá embaixo.
    //  - disponibilidade (envio/alteracao/cancelamento): só dentro da janela
    //  - idiomas: a qualquer momento
    match /notificacoes/{notifId} {
      allow create: if roleIs('guia')
        && request.resource.data.guideId == get(perfilPath()).data.guideId
        && request.resource.data.origem == 'guia'
        && request.resource.data.createdAt == request.time
        && (
          (
            request.resource.data.tipo in ['envio', 'alteracao', 'cancelamento']
            && janelaAberta()
            && request.resource.data.keys().hasOnly([
                 'tipo', 'origem', 'guideId', 'guideName',
                 'semanaInicio', 'semanaFim',
                 'adicionados', 'removidos', 'total', 'createdAt'
               ])
          ) || (
            request.resource.data.tipo == 'idiomas'
            && request.resource.data.keys().hasOnly([
                 'tipo', 'origem', 'guideId', 'guideName',
                 'adicionados', 'removidos', 'total', 'createdAt'
               ])
          )
        );
    }

    // ---------- Arquivos anexados (Central de Informações) ----------
    // arquivos/{id} (meta) e arquivos/{id}/partes/{n} (o conteúdo em base64).
    // O comercial só lê (anexos dos itens e as Condições gerais); quem envia,
    // troca e apaga é o operacional, pela regra geral lá embaixo.
    match /arquivos/{arquivoId} {
      allow get: if isComercial();
      match /partes/{parteId} {
        allow read: if isComercial();
      }
    }

    // ---------- Comercial: lê a Central de Dúvidas ----------
    match /faq_itens/{itemId} {
      allow read: if isComercial();
      // única escrita permitida: os contadores de uso (visualização / cópia)
      // — também para o Operacional na tela "Ver como o comercial"
      allow update: if (isComercial() || (podeArea('verComercial') && daSede()))
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['contadorVisualizacoes', 'contadorCopias']);
    }

    // ---------- Balanço de uso ----------
    // Um documento por pessoa por dia: {uid}__{AAAA-MM-DD}. Cada conta ativa
    // grava só o próprio; ninguém apaga (só pelo console do Firebase).
    match /atividade_diaria/{docId} {
      allow read: if podeVerBalanco()
        || (ativo() && resource.data.uid == request.auth.uid);
      allow create, update: if ativo()
        && docId.matches(request.auth.uid + '__[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.uid == request.auth.uid
        && (!('eventos' in request.resource.data) || request.resource.data.eventos.size() <= 200);
    }
    // Avaliação do sistema (0 a 5 estrelas + comentário): uma por conta.
    match /avaliacoes/{uid} {
      allow read: if podeVerBalanco() || (ativo() && request.auth.uid == uid);
      allow create, update: if ativo() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.nota is int
        && request.resource.data.nota >= 0 && request.resource.data.nota <= 5
        && request.resource.data.comentario is string
        && request.resource.data.comentario.size() <= 1000;
    }

    // ---------- Fornecedor parceiro ----------
    // providers[__base]/{fornecedorId}: só lê o próprio cadastro (veículos).
    // motoristas_fornecedor[__base]: os próprios motoristas (não apaga: desativa).
    // escala_motoristas[__base]/{AAAA-MM-DD}__{fornecedorId}: quem dirige cada
    //   serviço — o Painel do dia lê pela regra geral do Operacional.
    match /{colecao}/{docId} {
      allow get: if isFornecedor() && colDaMinhaBase(colecao, 'providers') && docId == meuFornecedor();
      allow read: if isFornecedor() && colDaMinhaBase(colecao, 'motoristas_fornecedor')
        && resource.data.fornecedorId == meuFornecedor();
      allow create: if isFornecedor() && colDaMinhaBase(colecao, 'motoristas_fornecedor') && motoristaValido();
      allow update: if isFornecedor() && colDaMinhaBase(colecao, 'motoristas_fornecedor')
        && resource.data.fornecedorId == meuFornecedor() && motoristaValido();
      allow get: if isFornecedor() && colDaMinhaBase(colecao, 'escala_motoristas')
        && docId.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}__' + meuFornecedor());
      allow create, update: if isFornecedor() && colDaMinhaBase(colecao, 'escala_motoristas')
        && escalaMotoristasValida(docId);
    }

    // ---------- Link do dia do motorista (sem login) ----------
    // motorista_dia/{token}: o token (24+ caracteres aleatórios) é a chave —
    // quem tem o link lê o documento (não dá para listar). O fornecedor monta
    // e atualiza; o motorista só grava as etapas e a posição. O Operacional
    // lê pela regra geral (Salvador) ou só os da própria base.
    match /motorista_dia/{token} {
      allow get: if token.size() >= 20;
      allow list: if isOperacional() && resource.data.base == minhaRegiao();
      allow create: if isFornecedor() && linkMotoristaValido();
      allow update: if isFornecedor() && resource.data.fornecedorId == meuFornecedor() && linkMotoristaValido();
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['eventos', 'ultimaPosicao', 'atualizadoEm'])
        && request.resource.data.eventos is map
        && request.resource.data.eventos.size() <= 60;
    }
    // motorista_app/{tokenApp}: link FIXO do app do motorista (o mesmo todo dia),
    // com o token do link de cada dia. Quem tem o link lê; o fornecedor mantém.
    match /motorista_app/{tokenApp} {
      allow get: if tokenApp.size() >= 20;
      allow create, update: if isFornecedor()
        && (resource == null || resource.data.fornecedorId == meuFornecedor())
        && request.resource.data.fornecedorId == meuFornecedor()
        && request.resource.data.base == minhaRegiao()
        && request.resource.data.keys().hasOnly([
             'base', 'fornecedorId', 'fornecedorNome', 'motoristaId', 'motoristaNome', 'dias', 'atualizadoEm'])
        && request.resource.data.dias is map
        && request.resource.data.dias.size() <= 400;
    }
    // push_escala/{base}__{data}__{escalaId}: inscrições de notificação push dos
    // celulares que fazem aquela chegada (o app do motorista grava, sem login).
    // Só o painel do aeroporto (Atendimento/Operacional) lê, para avisar.
    match /push_escala/{pushId} {
      allow get: if isAtendimento() || isOperacional();
      allow create, update: if pushId.matches(request.resource.data.base + '__.*')
        && request.resource.data.keys().hasOnly(['base', 'data', 'escalaId', 'inscricoes', 'atualizadoEm'])
        && request.resource.data.inscricoes is map
        && request.resource.data.inscricoes.size() <= 10;
    }

    // retorno_escala/{base}__{data}__{escalaId}: o app do motorista (sem login)
    // devolve para a base: abriu o app, viu o aviso, a caminho, posicionado,
    // em viagem, finalizado. O painel do aeroporto lê (consulta por base e data).
    match /retorno_escala/{retornoId} {
      allow read: if (isAtendimento() || isOperacional()) && resource.data.base == minhaRegiao();
      allow create, update: if retornoId.matches(request.resource.data.base + '__.*')
        && request.resource.data.keys().hasOnly([
             'base', 'data', 'escalaId', 'motoristaNome', 'conectadoEm', 'avisadoEm', 'recepcaoMs',
             'acaminhoEm', 'posicionadoEm', 'porta', 'iniciadoEm', 'finalizadoEm', 'atualizadoEm'])
        && request.resource.data.motoristaNome is string
        && request.resource.data.motoristaNome.size() <= 80;
    }

    // status_escala/{base}__{data}__{escalaId}: o painel do aeroporto avisa
    // "recepcionado / embarcado" para o link do motorista. Sem dados de
    // passageiro — qualquer um lê um documento pelo id; grava quem marca.
    match /status_escala/{statusId} {
      allow get: if true;
      allow create, update: if (isOperacional() || (isAtendimento() && request.resource.data.base == minhaRegiao()))
        && statusId.matches(request.resource.data.base + '__.*')
        && request.resource.data.keys().hasOnly([
             'base', 'data', 'escalaId', 'recepcionado', 'recepcionadoEm', 'recepcionadoPor',
             'embarcado', 'embarcadoEm', 'atualizadoEm']);
    }

    // ---------- Operacional (inclui coleções futuras) ----------
    // Todo o resto — services, weekly_services, guides, providers,
    // settings, guide_tour_levels, weekly_scale_meta,
    // painel_out_monitoramento, custos_dia... — cai aqui: só operacional,
    // respeitando as telas bloqueadas para a conta (podeLer/GravarColecao).
    // users fica de fora: tem regras próprias lá em cima.
    match /{colecao}/{docId}/{resto=**} {
      allow read: if podeLerColecao(colecao, docId);
      allow write: if podeGravarColecao(colecao, docId);
    }
    // conta Atendimento: só as marcas do aeroporto da própria base (não apaga)
    match /{colecao}/{docId} {
      allow read: if isAtendimento() && colecaoAtendimentos(colecao);
      allow create, update: if isAtendimento() && colecaoAtendimentos(colecao)
        && atendimentoValido();
    }
  }
}
